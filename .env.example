# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Ключ OpenAI для ассистента. Без него вся учётная часть работает, ассистент отвечает понятной ошибкой.
OPENAI_API_KEY=

# Секрет для подписи сессий. Для демо подойдёт любой длинный случайный текст.
JWT_SECRET=change-me-to-a-long-random-string

# Модели: основная и запасная (на неё ассистент переходит при 429, 5xx и таймауте).
LLM_PRIMARY_MODEL=gpt-6-luna
LLM_FALLBACK_MODEL=gpt-5.4-mini
# Сколько модели «думать»: none, low, medium, high. Пусто — по умолчанию модели (быстрее low, но ошибок больше, см. README).
LLM_REASONING_EFFORT=

# Тариф OpenAI: пусто — обычный, fast — быстрее и вдвое дороже, но по эвалам хуже выбирает инструменты.
LLM_SERVICE_TIER=
